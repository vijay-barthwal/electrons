# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — it will never be committed.

# SMTP settings for the contact-form email (works with any provider).
#
# The business inbox is a Gmail address, so this defaults to Gmail's SMTP —
# you need an App Password (not the regular Gmail password), which requires
# 2-Step Verification to be enabled first:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=electrons0511@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Where inquiries should be delivered. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=electrons0511@gmail.com

# The production URL this site is deployed at (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, and structured data.
# Only needed to override the placeholder default in site-config.ts once a
# real domain is registered.
NEXT_PUBLIC_SITE_URL=https://electrons-zirakpur.example.com

# Social links shown in the footer. All optional — leave any of them unset
# (or delete the line) to simply hide that icon. Must be NEXT_PUBLIC_ to be
# readable in the browser.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
